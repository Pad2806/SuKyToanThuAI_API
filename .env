# ============================================================
# SuKyAI API — Environment Variables (Supabase)
# NEVER commit this file to version control.
# ============================================================

# --- Database ---
# asyncpg driver required for SQLAlchemy async
DATABASE_URL=postgresql+asyncpg://postgres:sukytoanthuai@db.qqxltcdtrxdwkjakqcob.supabase.co:5432/postgres

# --- Security ---
SECRET_KEY=change-me-to-a-random-256-bit-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- 9router AI Provider ---
NINEROUTER_API_KEY=your-9router-api-key
NINEROUTER_BASE_URL=https://api.9router.ai/v1
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=intfloat/multilingual-e5-large
IMAGE_MODEL=dall-e-3

# --- S3-compatible Storage ---
S3_BUCKET=suky-ai
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_REGION=ap-southeast-1
S3_PUBLIC_BASE_URL=https://cdn.suky-ai.vn

# --- Worker ---
WORKER_ID=worker-001
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_JOB_LOCK_TIMEOUT_MINUTES=10

# --- App ---
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
API_PREFIX=/api/v1
