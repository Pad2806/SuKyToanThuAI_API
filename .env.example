# Database
# Supabase direct database hosts are IPv6-only by default. For Docker Desktop
# and other IPv4-only environments, use the Supavisor session pooler URL:
# postgresql+asyncpg://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT=10
DATABASE_POOL_RECYCLE_SECONDS=1800

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis
REDIS_URL=redis://redis:6379/0

# Official AI pipeline: Vertex AI only
AI_PROVIDER=vertex
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=sukyai-prod
GOOGLE_CLOUD_LOCATION=us-central1
AI_DRAFT_MODEL=gemini-2.5-pro
AI_FAST_MODEL=gemini-2.5-flash
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_IMAGE_MODEL=imagen-3.0-generate-002
