# =============================================================================
# SuKyAI Platform — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/sukyai
SYNC_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/sukyai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-use-a-long-random-string
JWT_ISSUER=sukyai
JWT_AUDIENCE=sukyai-api
# Shared secret for internal service-to-service calls
SERVICE_TOKEN=change-me-internal-service-token

# ── Internal Service URLs (used inside Docker network) ────────────────────────
AUTH_SERVICE_URL=http://auth-service:8001
CONTENT_SERVICE_URL=http://content-service:8002
RAG_SERVICE_URL=http://rag-service:8003
STORY_SERVICE_URL=http://story-service:8004

# ── AI Provider — 9router (OpenAI-compatible) ─────────────────────────────────
NINEROUTER_API_KEY=
NINEROUTER_BASE_URL=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=intfloat/multilingual-e5-large
IMAGE_MODEL=dall-e-3

# ── Object Storage (MinIO local / S3 / R2) ────────────────────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=sukyai
PUBLIC_CDN_BASE_URL=

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_ID=worker-001
WORKER_POLL_INTERVAL_SECONDS=5
