# Database
# Supabase direct database hosts are IPv6-only by default. For Docker Desktop
# and other IPv4-only environments, use the Supavisor session pooler URL:
# postgresql+asyncpg://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis
REDIS_URL=redis://redis:6379/0

# OpenAI via 9router/OpenAI-compatible API
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.9router.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
